  {    
    "layer": "top",
    "position": "top",
    "height": 27,

    "modules-left": ["hyprland/workspaces", "clock"],
    "modules-center": ["mpris"],
    "modules-right": ["tray", "network", "battery", "wireplumber"],

    "clock": {
        "format": "  {:%H:%M}",
        "tooltip-format": "{:%A, %B %d %Y}"
    },
/* no need for the battery
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""],
        "states": {
            "warning": 25,
            "critical": 10
        }
    },
*/
    "mpris": {
      "player": "firefox",
      "format": "{artist} - {title}",
      "format-paused": " {artist} - {title}",
      "format-stopped": "",
      "tooltip-format": "{player} : {status}",
      "max-length": 40
    },  

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  Connected",
        "format-disconnected": "󰤭  no net"
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-icons": ["", "", ""]
    }
}
